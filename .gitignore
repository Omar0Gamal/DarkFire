# Visual Studio / IDE
.vs/
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.sln
*.slnx
*.i64
Makefile

# Build Output Directories
bin/
bin-int/
Binaries/
x64/
Package/
Cooked/

# Crash dumps, logs & caches
*.log
*.dmp
Cache/
.tracy/

# Configuration files (ignore by default, allow in Templates/ and Editor/Config/)
*.ini
!Templates/**/*.ini
!Editor/Config/**/*.ini

# Whitelist Vendor Binaries
!Vendor/Binaries/**

# User Projects
Projects/*
!Projects/.gitkeep
